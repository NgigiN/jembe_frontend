#!/bin/sh
# Enforce the global rule (~/.claude/CLAUDE.md): NO AI attribution in commit
# messages, ever — strip any such trailer regardless of what wrote it.
# Overrides the per-session "Claude-Session:" attribution reminder.
tmp="$1.att.tmp"
grep -viE '^(Claude-Session:|Co-Authored-By:.*[Cc]laude|.*[Gg]enerated with.*[Cc]laude)' "$1" > "$tmp" 2>/dev/null || true
mv "$tmp" "$1"
exit 0
