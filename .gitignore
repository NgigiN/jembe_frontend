# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/v1/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local dev tooling (install/build/run helper scripts)
/scripts/

# graphify's analysis cache — machine-local tooling output, hundreds of
# hashed JSON files. Ignored at any depth because it is written both at the
# repo root and under lib/.
graphify-out/

# flutter_gen output (pubspec.yaml: flutter_gen.output). Regenerated by
# build_runner and imported by nothing, so it does not belong in the repo.
/lib/gen/

# Docs are local notes, not tracked - except the top-level README
*.md
!README.md

# Design docs live in the root-level farmTracker/docs, never in this repo
docs/superpowers/

# Local git worktrees for isolated feature-branch work
.worktrees/
